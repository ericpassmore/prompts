prefix_rule(pattern=["/bin/zsh", "-lc", "for key in $(redis-cli -u redis://localhost:6379/0 --scan --pattern 'clientid=*&key=Client'); do value=$(redis-cli -u redis://localhost:6379/0 --raw GET \"$key\"); id=$(printf '%s' \"$value\" | sed -n 's/.*\"Id\":\\([0-9]*\\).*/\\1/p'); name=$(printf '%s' \"$value\" | sed -n 's/.*\"CompanyName\":\"\\([^\"]*\\)\".*/\\1/p'); printf '%s | %s | %s\\n' \"$key\" \"$id\" \"$name\"; done | sort"], decision="allow")
