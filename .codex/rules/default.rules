prefix_rule(pattern=["/bin/bash", "-lc", "server=\"\"; db=\"\"; user=\"\"; pass=\"\"; IFS=\";\" read -ra parts <<< \"$ORDERPORT_DB_CONNECTION_STRING\"; for part in \"${parts[@]}\"; do key=\"${part%%=*}\"; val=\"${part#*=}\"; key_lc=$(printf \"%s\" \"$key\" | tr \"[:upper:]\" \"[:lower:]\" | tr -d \" _\"); case \"$key_lc\" in server|datasource|address|addr|networkaddress) server=\"$val\" ;; database|initialcatalog) db=\"$val\" ;; userid|user|uid) user=\"$val\" ;; password|pwd) pass=\"$val\" ;; esac; done; if [ -z \"$server\" ] || [ -z \"$db\" ]; then printf \"Connection string missing server or database\\n\"; exit 2; fi; if [ -n \"$user\" ]; then sqlcmd -S \"$server\" -d \"$db\" -U \"$user\" -P \"$pass\" -Q \"SET NOCOUNT ON; SELECT DB_NAME() AS DatabaseName, SUSER_SNAME() AS LoginName;\" -W; else sqlcmd -S \"$server\" -d \"$db\" -E -Q \"SET NOCOUNT ON; SELECT DB_NAME() AS DatabaseName, SUSER_SNAME() AS LoginName;\" -W; fi"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "server=\"\"; db=\"\"; user=\"\"; pass=\"\"; IFS=\";\" read -ra parts <<< \"$ORDERPORT_DB_CONNECTION_STRING\"; for part in \"${parts[@]}\"; do key=\"${part%%=*}\"; val=\"${part#*=}\"; key_lc=$(printf \"%s\" \"$key\" | tr \"[:upper:]\" \"[:lower:]\" | tr -d \" _\"); case \"$key_lc\" in server|datasource|address|addr|networkaddress) server=\"$val\" ;; database|initialcatalog) db=\"$val\" ;; userid|user|uid) user=\"$val\" ;; password|pwd) pass=\"$val\" ;; esac; done; sqlcmd -S \"$server\" -d \"$db\" -U \"$user\" -P \"$pass\" -Q \"SET NOCOUNT ON; SELECT TABLE_NAME, COLUMN_NAME, DATA_TYPE, CHARACTER_MAXIMUM_LENGTH, NUMERIC_PRECISION, NUMERIC_SCALE, IS_NULLABLE FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME IN (N\\'ShippingZone\\',N\\'ShippingQtyMatrixByZoneRule\\',N\\'ShippingService\\') ORDER BY TABLE_NAME, ORDINAL_POSITION;\" -W"], decision="allow")
